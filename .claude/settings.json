{
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(npm publish:*)",
      "Bash(sudo:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task|Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit|Read",
        "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/factory/scripts/guard.mjs\"" } ]
      }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/factory/scripts/track-tokens.mjs\"" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/factory/scripts/track-tokens.mjs\" --main" } ] }
    ]
  }
}
